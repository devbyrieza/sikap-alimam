generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  nama       String
  role       String   @default("guru") // ADMIN_SUPER | ADMIN_KEUANGAN | MUDIR | KEPALA_SEKOLAH | KASI_PENGASUHAN | KASI_ASRAMA | KASI_KEDISIPLINAN | KASI_KURIKULUM | GURU | MUSYRIF | WALI_SANTRI
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  pegawai   Pegawai?
  orang_tua OrangTuaSantri[]

  @@map("users")
}

// ─── MASTER DATA ────────────────────────────────────────────────────────────

model Pegawai {
  id                  String    @id @default(uuid()) @db.Uuid
  nik                 String?   @unique
  nama_lengkap        String
  jenis_kelamin       String?
  tempat_lahir        String?
  tanggal_lahir       DateTime? @db.Date
  no_hp               String?
  email               String?
  alamat              String?
  kategori_pegawai    String    @default("PEGAWAI_UMUM") // ASATIDZ, PEGAWAI_UMUM, MUSYRIF
  unit_kerja          String?
  divisi              String?
  jabatan             String?
  mata_pelajaran      String?
  pendidikan_terakhir String?
  status_pernikahan   String?
  foto_url            String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  user_id             String?   @unique @db.Uuid

  user            User?             @relation(fields: [user_id], references: [id])
  jurnal          JurnalMengajar[]
  presensi        PresensiAsatidz[]
  mengajar        AsatidzmMapel[]
  capaian_tahfidz CapaianTahfidz[]
  ibadah_adab     IbadahAdabSantri[]

  @@map("pegawai")
}

model Kelas {
  id        String  @id @default(uuid()) @db.Uuid
  nama      String  @unique // "7 MTs" | "IL"
  jenjang   String? // "MTs" | "Islamiyah"
  is_active Boolean @default(true)

  santri         SantriAktif[]
  presensi_siswa PresensiSiswa[]
  jurnal         JurnalMengajar[]
  nilai          NilaiSantri[]
  mapel          AsatidzmMapel[]
  MataPelajaran  MataPelajaran[]

  @@map("kelas")
}

model MataPelajaran {
  id        String  @id @default(uuid()) @db.Uuid
  nama      String
  kategori  String  @default("umum") // "agama" | "umum"
  kelas_id  String  @db.Uuid
  is_active Boolean @default(true)

  kelas         Kelas            @relation(fields: [kelas_id], references: [id])
  asatidz_mapel AsatidzmMapel[]
  jurnal        JurnalMengajar[]
  nilai         NilaiSantri[]

  @@unique([nama, kelas_id])
  @@map("mata_pelajaran")
}

model AsatidzmMapel {
  id         String @id @default(uuid()) @db.Uuid
  pegawai_id String @db.Uuid
  mapel_id   String @db.Uuid
  kelas_id   String @db.Uuid

  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])
  mapel   MataPelajaran @relation(fields: [mapel_id], references: [id])
  kelas   Kelas         @relation(fields: [kelas_id], references: [id])

  @@unique([pegawai_id, mapel_id, kelas_id])
  @@map("asatidz_mapel")
}

model SantriAktif {
  id            String   @id @default(uuid()) @db.Uuid
  nis           String?  @unique
  nama_lengkap  String
  kelas_id      String   @db.Uuid
  jenis_kelamin String?
  foto_url      String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  kelas           Kelas            @relation(fields: [kelas_id], references: [id])
  presensi        PresensiSiswa[]
  nilai           NilaiSantri[]
  capaian_tahfidz CapaianTahfidz[]
  orang_tua       OrangTuaSantri[]
  ibadah_adab     IbadahAdabSantri[]

  @@map("santri_aktif")
}

// ─── JURNAL MENGAJAR ────────────────────────────────────────────────────────

model JurnalMengajar {
  id         String   @id @default(uuid()) @db.Uuid
  pegawai_id String @db.Uuid
  mapel_id   String   @db.Uuid
  kelas_id   String   @db.Uuid
  tanggal    DateTime @db.Date
  jam_ke     String? // "1-2", "3", dll
  materi     String
  kegiatan   String
  catatan    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])
  mapel   MataPelajaran @relation(fields: [mapel_id], references: [id])
  kelas   Kelas         @relation(fields: [kelas_id], references: [id])

  @@map("jurnal_mengajar")
}

// ─── PRESENSI SANTRI ────────────────────────────────────────────────────────

model PresensiSiswa {
  id         String   @id @default(uuid()) @db.Uuid
  santri_id  String   @db.Uuid
  kelas_id   String   @db.Uuid
  tanggal    DateTime @db.Date
  status     String // hadir | sakit | izin | alpha
  keterangan String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  santri SantriAktif @relation(fields: [santri_id], references: [id])
  kelas  Kelas       @relation(fields: [kelas_id], references: [id])

  @@unique([santri_id, tanggal])
  @@map("presensi_siswa")
}

// ─── ABSENSI ASATIDZ ────────────────────────────────────────────────────────

model TokenHarian {
  id         String   @id @default(uuid()) @db.Uuid
  tanggal    DateTime @unique @db.Date
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("token_harian")
}

model PresensiAsatidz {
  id         String    @id @default(uuid()) @db.Uuid
  pegawai_id String @db.Uuid
  tanggal    DateTime  @db.Date
  jam_masuk  DateTime? @db.Timestamptz(6)
  jam_keluar DateTime? @db.Timestamptz(6)
  status     String    @default("hadir") // hadir | sakit | izin | telat | alpha
  metode     String    @default("link") // link | manual
  lat        Float?
  lng        Float?
  foto_url   String?
  keterangan String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])

  @@unique([pegawai_id, tanggal])
  @@map("presensi_asatidz")
}

// ─── NILAI ──────────────────────────────────────────────────────────────────

model NilaiSantri {
  id           String   @id @default(uuid()) @db.Uuid
  santri_id    String   @db.Uuid
  mapel_id     String   @db.Uuid
  kelas_id     String   @db.Uuid
  semester     String // "1" | "2"
  tahun_ajaran String // "2025/2026"
  jenis        String // harian | kompetensi | sikap | pts | pas
  nilai        Float
  keterangan   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  santri SantriAktif   @relation(fields: [santri_id], references: [id])
  mapel  MataPelajaran @relation(fields: [mapel_id], references: [id])
  kelas  Kelas         @relation(fields: [kelas_id], references: [id])

  @@map("nilai_santri")
}

// ─── TAHFIDZ ────────────────────────────────────────────────────────────────

model CapaianTahfidz {
  id         String   @id @default(uuid()) @db.Uuid
  santri_id  String   @db.Uuid
  pegawai_id String @db.Uuid // Musyrif/Guru pengampu tahfidz
  tanggal    DateTime @db.Date
  jenis      String // ziyadah | murojaah_harian | murojaah_pekanan | ujian_pekanan | ujian_juz
  surat      String
  halaman    String?
  ayat       String?
  nilai      Float? // Opsional: Jika ujian, bisa diisi nilai angkanya
  keterangan String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  santri  SantriAktif @relation(fields: [santri_id], references: [id])
  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])

  @@map("capaian_tahfidz")
}

// ─── WALI SANTRI ────────────────────────────────────────────────────────────

model OrangTuaSantri {
  id        String @id @default(uuid()) @db.Uuid
  user_id   String @db.Uuid
  santri_id String @db.Uuid

  user   User        @relation(fields: [user_id], references: [id])
  santri SantriAktif @relation(fields: [santri_id], references: [id])

  @@unique([user_id, santri_id])
  @@map("orangtua_santri")
}

// ─── BINA PRIBADI ISLAMI (BPI) ──────────────────────────────────────────────

model IbadahAdabSantri {
  id         String   @id @default(uuid()) @db.Uuid
  santri_id  String   @db.Uuid
  pegawai_id String   @db.Uuid // Musyrif yang mengisi
  tanggal    DateTime @db.Date

  // Sholat Wajib (Berjamaah, Munfarid, Terlambat, Bolong, Udzur)
  shubuh   String @default("Berjamaah")
  dzuhur   String @default("Berjamaah")
  ashar    String @default("Berjamaah")
  maghrib  String @default("Berjamaah")
  isya     String @default("Berjamaah")

  // Amalan Sunnah
  tahajjud   Boolean @default(false)
  dhuha      Boolean @default(false)
  shaum      Boolean @default(false)
  almatsurat Boolean @default(false)

  // Adab
  adab_kamar String? // A, B, C, D
  adab_masjid String?
  catatan  String?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  santri  SantriAktif @relation(fields: [santri_id], references: [id])
  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])

  @@unique([santri_id, tanggal])
  @@map("ibadah_adab_santri")
}
