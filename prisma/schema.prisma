enum KodeDivisi {
  TU   // Tata Usaha
  KS   // Kesantrian / Pengasuhan
  AK   // Akademik / Kurikulum
  KU   // Keuangan
  PSB  // Panitia Penerimaan Santri Baru
}

// ─── MERGED FROM SIMPEG: StatusSurat ────────────────────────────────
enum StatusSurat {
  DRAFT
  PUBLISHED
}

// ─── MERGED FROM SIMPEG: SuratKeluar ────────────────────────────────
model SuratKeluar {
  id              String      @id @default(uuid()) @db.Uuid
  nomor_urut      Int         // Nomor urut dalam satu tahun ajaran (reset tiap Juli)
  nomor_surat     String      @unique // Format: 001/UND/TU/PP-AI/VI/2026
  jenis_surat     JenisSurat
  kode_divisi     KodeDivisi
  judul           String
  perihal         String
  isi_singkat     String?     @db.Text
  tanggal_surat   DateTime    @db.Date
  bulan_romawi    String      // I, II, III, IV, V, VI, VII, VIII, IX, X, XI, XII
  tahun           Int
  tahun_ajaran    String      // e.g. "2026/2027"
  status          StatusSurat @default(DRAFT)
  file_path       String?     // URL ke file PDF (Supabase Storage / local)
  file_name       String?
  penerima        String?     // Ditujukan kepada (opsional)
  dibuat_oleh     String?     @db.Uuid
  published_at    DateTime?   @db.Timestamptz(6)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)

  pembuat         Profile?    @relation("SuratDibuatOleh", fields: [dibuat_oleh], references: [id])

  @@index([tahun_ajaran, nomor_urut])
  @@index([status, tanggal_surat])
  @@map("surat_keluar")
}

// ─── MERGED FROM SIMPEG: KalenderAkademik ────────────────────────────────
model KalenderAkademik {
  id              String      @id @default(uuid()) @db.Uuid
  tahun_ajaran_id String      @db.Uuid
  nama_kegiatan   String
  tanggal_mulai   DateTime    @db.Date
  tanggal_selesai DateTime    @db.Date
  kategori        String      @default("AKADEMIK") // "AKADEMIK", "LIBUR", "PSB", "ASRAMA", "KEUANGAN", dll
  deskripsi       String?     @db.Text
  is_libur        Boolean     @default(false)
  warna_label     String?     @default("blue")
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)

  tahun_ajaran    TahunAjaran @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)

  @@index([tanggal_mulai, tanggal_selesai])
  @@map("kalender_akademik")
}
