  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("pending_sms")
}

// ─── MERGED FROM SIMPEG: WhatsappLog ────────────────────────────────
model WhatsappLog {
  id              String     @id @default(uuid()) @db.Uuid
  pendaftar_id    String?    @db.Uuid
  phone           String
  jenis_notif     String
  status          String     @default("pending")
  response_data   String?
  attempt_count   Int        @default(0)
  max_attempts    Int        @default(3)
  scheduled_at    DateTime   @default(now()) @db.Timestamptz(6)
  sent_at         DateTime?  @db.Timestamptz(6)
  failed_at       DateTime?  @db.Timestamptz(6)
  error_message   String?
  message_content String?
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @db.Timestamptz(6)
  pendaftar       Pendaftar? @relation(fields: [pendaftar_id], references: [id])

  @@index([status, scheduled_at])
  @@index([pendaftar_id, jenis_notif])
  @@index([phone])
  @@map("whatsapp_log")
}

// ─── MERGED FROM SIMPEG: WhatsappCooldown ────────────────────────────────
model WhatsappCooldown {
  id             String    @id @default("global")
  last_sent_at   DateTime? @db.Timestamptz(6)
  sent_count_10m Int       @default(0)
  cooldown_until DateTime? @db.Timestamptz(6)
  hourly_count   Int       @default(0)
  hourly_reset   DateTime? @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@map("whatsapp_cooldown")
}

// ─── MERGED FROM SIMPEG: JadwalNotifReminder ────────────────────────────────
model JadwalNotifReminder {
  id              String      @id @default(uuid()) @db.Uuid
  jadwal_ujian_id String      @db.Uuid
  pendaftar_id    String      @db.Uuid
  reminder_sent   Boolean     @default(false)
  sent_at         DateTime?   @db.Timestamptz(6)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  jadwal_ujian    JadwalUjian @relation(fields: [jadwal_ujian_id], references: [id], onDelete: Cascade)
  pendaftar       Pendaftar   @relation(fields: [pendaftar_id], references: [id], onDelete: Cascade)

  @@unique([jadwal_ujian_id, pendaftar_id])
  @@map("jadwal_notif_reminder")
}

// ─── MERGED FROM SIMPEG: PendaftarBackup ────────────────────────────────
model PendaftarBackup {
