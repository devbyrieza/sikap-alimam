// ─── MERGED FROM SIMPEG: PengajuanBeasiswa ────────────────────────────────
model PengajuanBeasiswa {
  id                  String   @id @default(uuid()) @db.Uuid
  pendaftar_id        String   @unique @db.Uuid
  tahun_ajaran_id     String   @db.Uuid
  jenis_pengajuan     String // "BEASISWA_PRESTASI" | "KERINGANAN_BIAYA"
  alasan_pengajuan    String?  @db.Text
  nominal_kesanggupan Decimal? @db.Decimal

  file_sktm_path        String?
  file_slip_gaji_path   String?
  file_ktp_path         String?   // KTP Ayah (untuk Beasiswa)
  file_ktp_ibu_path     String?   // KTP Ibu (untuk Beasiswa)
  file_prestasi_path    String?   // Bukti prestasi (Beasiswa) / Surat Permohonan (Keringanan)
  file_permohonan_path  String?   // Surat Permohonan Keringanan (field dedicated)
  diajukan_oleh_id    String? @db.Uuid
  diajukan_oleh_role  String?

  status String @default("PENDING") // "PENDING" | "DISETUJUI" | "DITOLAK"

  disetujui_oleh      String?   @db.Uuid
  disetujui_pada      DateTime? @db.Timestamptz(6)
  catatan_keputusan   String?   @db.Text
  tipe_potongan       String? // "NOMINAL" | "PERSENTASE"
  nominal_potongan    Decimal?  @db.Decimal
  persentase_potongan Decimal?  @db.Decimal(5, 2)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  pendaftar    Pendaftar   @relation(fields: [pendaftar_id], references: [id], onDelete: Cascade)
  tahun_ajaran TahunAjaran @relation(fields: [tahun_ajaran_id], references: [id])
  approver     Profile?    @relation("BeasiswaApprovedBy", fields: [disetujui_oleh], references: [id])

  @@map("pengajuan_beasiswa")
}

// ─── MERGED FROM SIMPEG: DompetSantri ────────────────────────────────
model DompetSantri {
  id             String   @id @default(uuid()) @db.Uuid
  pendaftar_id   String   @unique @db.Uuid // Relasi ke pendaftar/santri
  qr_code_string String   @unique // String unik yang ada di QR Card
  saldo          Decimal  @default(0) @db.Decimal(12, 2)
  status               String    @default("AKTIF") // AKTIF, BLOKIR, HILANG
  pin                  String?
  batas_jajan_harian   Decimal   @default(25000) @db.Decimal(12, 2)
  batas_maksimal_saldo Decimal   @default(2000000) @db.Decimal(12, 2)
  is_limit_terbuka     Boolean   @default(false)
  limit_terbuka_sampai DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)

  transaksi TransaksiDompet[]
  pendaftar Pendaftar         @relation(fields: [pendaftar_id], references: [id])

  @@map("dompet_santri")
}

// ─── MERGED FROM SIMPEG: TransaksiDompet ────────────────────────────────
model TransaksiDompet {
  id              String   @id @default(uuid()) @db.Uuid
  dompet_id       String   @db.Uuid
  jenis_transaksi String // "TOPUP", "JAJAN_KANTIN", "JAJAN_KOPERASI", "TARIK_TUNAI"
  nominal         Decimal  @db.Decimal(12, 2)
  saldo_akhir     Decimal  @db.Decimal(12, 2) // Snapshot saldo setelah transaksi
  keterangan      String?
  kasir_id        String?  @db.Uuid // Admin/Kasir yang memproses
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  dompet DompetSantri @relation(fields: [dompet_id], references: [id])
  kasir  Profile?     @relation(fields: [kasir_id], references: [id])

  @@map("transaksi_dompet")
}

// ─── MERGED FROM SIMPEG: PerizinanSantri ────────────────────────────────
model PerizinanSantri {
  id              String    @id @default(uuid()) @db.Uuid
  pendaftar_id    String    @db.Uuid
  jenis_izin      String // "PULANG", "KELUAR_PONDOK", "SAKIT"
  alasan          String
  waktu_keluar    DateTime  @default(now()) @db.Timestamptz(6)
  batas_kembali   DateTime? @db.Timestamptz(6)
  waktu_kembali   DateTime? @db.Timestamptz(6)
  status          String    @default("DI_LUAR") // "DI_LUAR", "SUDAH_KEMBALI", "TERLAMBAT"
  pemberi_izin_id String    @db.Uuid

  pendaftar    Pendaftar @relation(fields: [pendaftar_id], references: [id])
  pemberi_izin Profile   @relation(fields: [pemberi_izin_id], references: [id])

  @@map("perizinan_santri")
}

