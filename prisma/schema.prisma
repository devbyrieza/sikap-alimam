generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  password       String
  plain_password String?
  nama           String
  role           String   @default("guru") // ADMIN_SUPER | ADMIN_KEUANGAN | MUDIR | KEPALA_SEKOLAH | KASI_PENGASUHAN | KASI_ASRAMA | KASI_KEDISIPLINAN | KASI_KURIKULUM | GURU | MUSYRIF | WALI_SANTRI
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  pegawai               Pegawai?
  orang_tua             OrangTuaSantri[]
  password_reset_tokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── MASTER DATA ────────────────────────────────────────────────────────────

model Pegawai {
  id                  String    @id @default(uuid()) @db.Uuid
  nip                 String?   @unique
  nik                 String?   @unique
  nama_lengkap        String
  jenis_kelamin       String?
  tempat_lahir        String?
  tanggal_lahir       DateTime? @db.Date
  no_hp               String?
  email               String?
  alamat              String?
  kategori_pegawai    String    @default("PEGAWAI_UMUM") // ASATIDZ, PEGAWAI_UMUM, MUSYRIF
  unit_kerja          String?
  divisi              String?
  jabatan             String?
  mata_pelajaran      String?
  pendidikan_terakhir String?
  status_pernikahan   String?
  foto_url            String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  user_id             String?   @unique @db.Uuid

  user              User?             @relation(fields: [user_id], references: [id])
  jurnal            JurnalMengajar[]
  presensi          PresensiAsatidz[]
  mengajar          AsatidzmMapel[]
  capaian_tahfidz   CapaianTahfidz[]
  ibadah_adab       IbadahAdabSantri[]
  jadwal            JadwalPelajaran[]
  kelas_wali        Kelas[]           @relation("WaliKelas")
  halaqoh_kelompok  HalaqohKelompok[]
  catatan_halaqoh   CatatanHalaqoh[]
  ujian_tahfidz     UjianTahfidz[]

  @@map("pegawai")
}

model Kelas {
  id            String   @id @default(uuid()) @db.Uuid
  nama          String   @unique // "7 MTs" | "IL"
  jenjang       String?  // "MTs" | "Islamiyah"
  is_active     Boolean  @default(true)
  wali_kelas_id String?  @db.Uuid

  wali_kelas       Pegawai?          @relation("WaliKelas", fields: [wali_kelas_id], references: [id])
  santri           SantriAktif[]
  presensi_siswa   PresensiSiswa[]
  jurnal           JurnalMengajar[]
  nilai            NilaiSantri[]
  mapel            AsatidzmMapel[]
  MataPelajaran    MataPelajaran[]
  jadwal           JadwalPelajaran[]
  halaqoh_kelompok HalaqohKelompok[]

  @@map("kelas")
}

model MataPelajaran {
  id        String  @id @default(uuid()) @db.Uuid
  nama      String
  nama_arab String? // "التوحيد", "التفسير", dsb
  kategori  String  @default("umum") // "syariah" | "bahasa" | "umum"
  kelas_id  String  @db.Uuid
  is_active Boolean @default(true)

  kelas         Kelas            @relation(fields: [kelas_id], references: [id])
  asatidz_mapel AsatidzmMapel[]
  jurnal        JurnalMengajar[]
  nilai         NilaiSantri[]
  jadwal        JadwalPelajaran[]
  presensi      PresensiSiswa[]

  @@unique([nama, kelas_id])
  @@map("mata_pelajaran")
}

model AsatidzmMapel {
  id         String @id @default(uuid()) @db.Uuid
  pegawai_id String @db.Uuid
  mapel_id   String @db.Uuid
  kelas_id   String @db.Uuid

  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])
  mapel   MataPelajaran @relation(fields: [mapel_id], references: [id])
  kelas   Kelas         @relation(fields: [kelas_id], references: [id])

  @@unique([pegawai_id, mapel_id, kelas_id])
  @@map("asatidz_mapel")
}

model SantriAktif {
  id            String   @id @default(uuid()) @db.Uuid
  nis           String?  @unique
  nama_lengkap  String
  kelas_id      String   @db.Uuid
  jenis_kelamin String?
  foto_url      String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  kelas             Kelas            @relation(fields: [kelas_id], references: [id])
  presensi          PresensiSiswa[]
  nilai             NilaiSantri[]
  capaian_tahfidz   CapaianTahfidz[]
  orang_tua         OrangTuaSantri[]
  ibadah_adab       IbadahAdabSantri[]
  pembayaran_spp    PembayaranSPP[]
  halaqoh_anggota   HalaqohAnggota[]
  catatan_halaqoh   CatatanHalaqoh[]
  ujian_tahfidz     UjianTahfidz[]

  @@map("santri_aktif")
}

// ─── KEUANGAN & PEMBAYARAN SPP ─────────────────────────────────────────────

model PembayaranSPP {
  id            String    @id @default(uuid()) @db.Uuid
  santri_id     String    @db.Uuid
  bulan         Int       // 1 - 12 (Januari - Desember)
  tahun         Int       // 2025, 2026, dst.
  nominal       Float     @default(1500000)
  status        String    @default("belum_lunas") // "lunas" | "belum_lunas"
  tanggal_bayar DateTime? @db.Timestamptz(6)
  metode_bayar  String?   @default("transfer") // "transfer" | "tunai"
  catatan       String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  santri        SantriAktif @relation(fields: [santri_id], references: [id], onDelete: Cascade)

  @@unique([santri_id, bulan, tahun])
  @@map("pembayaran_spp")
}

// ─── JURNAL MENGAJAR ────────────────────────────────────────────────────────

model JurnalMengajar {
  id         String   @id @default(uuid()) @db.Uuid
  pegawai_id String @db.Uuid
  mapel_id   String   @db.Uuid
  kelas_id   String   @db.Uuid
  tanggal    DateTime @db.Date
  jam_ke           String? // "1-2", "3", dll
  materi           String
  sub_materi       String? // Tambahan Sub Topik
  learning_outcome String? // LO / Tujuan Pembelajaran
  kegiatan         String
  catatan          String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])
  mapel   MataPelajaran @relation(fields: [mapel_id], references: [id])
  kelas   Kelas         @relation(fields: [kelas_id], references: [id])

  @@map("jurnal_mengajar")
}

// ─── PRESENSI SANTRI ────────────────────────────────────────────────────────

model PresensiSiswa {
  id         String   @id @default(uuid()) @db.Uuid
  santri_id  String   @db.Uuid
  kelas_id   String   @db.Uuid
  tanggal    DateTime @db.Date
  status     String // hadir | sakit | izin | alpha
  keterangan String?
  mapel_id   String?  @db.Uuid
  jam_ke     String? // "1-2", "3", dll
  created_at DateTime @default(now()) @db.Timestamptz(6)

  santri SantriAktif    @relation(fields: [santri_id], references: [id])
  kelas  Kelas          @relation(fields: [kelas_id], references: [id])
  mapel  MataPelajaran? @relation(fields: [mapel_id], references: [id])

  @@unique([santri_id, tanggal, mapel_id, jam_ke])
  @@map("presensi_siswa")
}

// ─── ABSENSI ASATIDZ ────────────────────────────────────────────────────────

model TokenHarian {
  id         String   @id @default(uuid()) @db.Uuid
  tanggal    DateTime @unique @db.Date
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("token_harian")
}

model PresensiAsatidz {
  id         String    @id @default(uuid()) @db.Uuid
  pegawai_id String @db.Uuid
  tanggal    DateTime  @db.Date
  jam_masuk  DateTime? @db.Timestamptz(6)
  jam_keluar DateTime? @db.Timestamptz(6)
  status     String    @default("hadir") // hadir | sakit | izin | telat | alpha
  metode     String    @default("link") // link | manual
  lat        Float?
  lng        Float?
  foto_url   String?
  keterangan String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])

  @@unique([pegawai_id, tanggal])
  @@map("presensi_asatidz")
}

// ─── NILAI ──────────────────────────────────────────────────────────────────

model NilaiSantri {
  id           String   @id @default(uuid()) @db.Uuid
  santri_id    String   @db.Uuid
  mapel_id     String   @db.Uuid
  kelas_id     String   @db.Uuid
  semester     String // "1" | "2"
  tahun_ajaran String // "2025/2026"
  jenis        String // harian | kompetensi | sikap | pts | pas
  nilai        Float
  keterangan   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  santri SantriAktif   @relation(fields: [santri_id], references: [id])
  mapel  MataPelajaran @relation(fields: [mapel_id], references: [id])
  kelas  Kelas         @relation(fields: [kelas_id], references: [id])

  @@map("nilai_santri")
}

// ─── TAHFIDZ ────────────────────────────────────────────────────────────────

model CapaianTahfidz {
  id         String   @id @default(uuid()) @db.Uuid
  santri_id  String   @db.Uuid
  pegawai_id String @db.Uuid // Musyrif/Guru pengampu tahfidz
  tanggal    DateTime @db.Date
  jenis      String // ziyadah | murojaah_harian | murojaah_pekanan | ujian_pekanan | ujian_juz
  surat      String
  halaman    String?
  ayat       String?
  nilai      Float? // Opsional: Jika ujian, bisa diisi nilai angkanya
  keterangan String?
  
  // Field Tambahan Rentang Surat/Ayat
  surat_dari String?
  ayat_dari  String?
  surat_ke   String?
  ayat_ke    String?
  
  created_at DateTime @default(now()) @db.Timestamptz(6)

  santri  SantriAktif @relation(fields: [santri_id], references: [id])
  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])

  @@map("capaian_tahfidz")
}

// ─── HALAQOH KEPENGASUHAN ───────────────────────────────────────────────────

// Kelompok Halaqoh: Satu pengampu mengampu satu kelompok di satu sesi
model HalaqohKelompok {
  id            String   @id @default(uuid()) @db.Uuid
  pegawai_id    String   @db.Uuid
  kelas_id      String?  @db.Uuid
  nama_kelompok String
  sesi          String   // "subuh" | "maghrib" | "dhuha"
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  pegawai Pegawai          @relation(fields: [pegawai_id], references: [id])
  kelas   Kelas?           @relation(fields: [kelas_id], references: [id])
  anggota HalaqohAnggota[]
  catatan CatatanHalaqoh[]

  @@map("halaqoh_kelompok")
}

// Daftar Santri dalam suatu Kelompok Halaqoh
model HalaqohAnggota {
  id          String   @id @default(uuid()) @db.Uuid
  kelompok_id String   @db.Uuid
  santri_id   String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  kelompok HalaqohKelompok @relation(fields: [kelompok_id], references: [id], onDelete: Cascade)
  santri   SantriAktif     @relation(fields: [santri_id], references: [id])

  @@unique([kelompok_id, santri_id])
  @@map("halaqoh_anggota")
}

// Catatan Harian Halaqoh per Santri per Sesi
model CatatanHalaqoh {
  id              String   @id @default(uuid()) @db.Uuid
  kelompok_id     String   @db.Uuid
  pegawai_id      String   @db.Uuid
  santri_id       String   @db.Uuid
  tanggal         DateTime @db.Date
  sesi            String   // "subuh" | "maghrib" | "dhuha"
  jenis           String   // "ziyadah" | "murojaah"
  surah_nomor     Int
  surah_nama      String
  surah_nama_arab String?
  ayat_dari       Int
  ayat_ke         Int
  jumlah_halaman  Float
  kehadiran       String   @default("hadir") // hadir | sakit | izin | alfa
  alasan          String?
  nilai_sikap     Float
  nilai_bacaan    Float
  nilai_akhir     Float
  catatan         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  kelompok HalaqohKelompok @relation(fields: [kelompok_id], references: [id])
  pegawai  Pegawai         @relation(fields: [pegawai_id], references: [id])
  santri   SantriAktif     @relation(fields: [santri_id], references: [id])

  @@unique([santri_id, tanggal, sesi])
  @@map("catatan_halaqoh")
}

// Rekap Ujian Tahfidz (Pekanan, Bulanan, Target, Itqon per 5 juz)
model UjianTahfidz {
  id              String   @id @default(uuid()) @db.Uuid
  santri_id       String   @db.Uuid
  pegawai_id      String   @db.Uuid  // Penguji / Musyrif
  tanggal         DateTime @db.Date
  jenis_ujian     String   // "ujian_pekanan" | "ujian_bulanan" | "ujian_target" | "ujian_itqon"
  juz             Int?     // Khusus untuk Ujian Itqon (misal: juz 1-5 = 5)
  surah_nomor     Int?
  surah_nama      String?
  ayat_dari       Int?
  ayat_ke         Int?
  jumlah_halaman  Float?
  nilai_bacaan    Float
  nilai_sikap     Float    @default(82)
  nilai_akhir     Float
  is_lulus        Boolean  @default(true) // Untuk Itqon (+10 bonus)
  catatan         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  pegawai Pegawai     @relation(fields: [pegawai_id], references: [id])
  santri  SantriAktif @relation(fields: [santri_id], references: [id])

  @@map("ujian_tahfidz")
}

// ─── WALI SANTRI ────────────────────────────────────────────────────────────

model OrangTuaSantri {
  id        String @id @default(uuid()) @db.Uuid
  user_id   String @db.Uuid
  santri_id String @db.Uuid

  user   User        @relation(fields: [user_id], references: [id])
  santri SantriAktif @relation(fields: [santri_id], references: [id])

  @@unique([user_id, santri_id])
  @@map("orangtua_santri")
}

// ─── BINA PRIBADI ISLAMI (BPI) ──────────────────────────────────────────────

model IbadahAdabSantri {
  id         String   @id @default(uuid()) @db.Uuid
  santri_id  String   @db.Uuid
  pegawai_id String   @db.Uuid // Musyrif yang mengisi
  tanggal    DateTime @db.Date

  // Sholat Wajib (Berjamaah, Munfarid, Terlambat, Bolong, Udzur)
  shubuh   String @default("Berjamaah")
  dzuhur   String @default("Berjamaah")
  ashar    String @default("Berjamaah")
  maghrib  String @default("Berjamaah")
  isya     String @default("Berjamaah")

  // Amalan Sunnah
  tahajjud   Boolean @default(false)
  dhuha      Boolean @default(false)
  shaum      Boolean @default(false)
  almatsurat Boolean @default(false)

  // Adab
  adab_kamar String? // A, B, C, D
  adab_masjid String?
  catatan  String?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  santri  SantriAktif @relation(fields: [santri_id], references: [id])
  pegawai Pegawai @relation(fields: [pegawai_id], references: [id])

  @@unique([santri_id, tanggal])
  @@map("ibadah_adab_santri")
}

// ─── JADWAL PELAJARAN ───────────────────────────────────────────────────────

model JadwalPelajaran {
  id            String   @id @default(uuid()) @db.Uuid
  hari          String   // "Senin", "Selasa", dll
  jam_ke        Int      // 1, 2, 3...
  waktu_mulai   String   // "07:00"
  waktu_selesai String   // "07:40"
  kelas_id      String   @db.Uuid
  pegawai_id    String   @db.Uuid
  mapel_id      String   @db.Uuid
  tipe_pekan    String   @default("semua") // "semua" | "ganjil" | "genap"
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  kelas   Kelas         @relation(fields: [kelas_id], references: [id])
  pegawai Pegawai       @relation(fields: [pegawai_id], references: [id])
  mapel   MataPelajaran @relation(fields: [mapel_id], references: [id])

  @@map("jadwal_pelajaran")
}

// ─── MASTER SESI WAKTU ──────────────────────────────────────────────────────

model MasterSesiWaktu {
  id            String   @id @default(uuid()) @db.Uuid
  jam_ke        Int      @unique
  waktu_mulai   String   // format "HH:mm", misal "07:00"
  waktu_selesai String   // format "HH:mm", misal "07:40"
  durasi_menit  Int      @default(40)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("master_sesi_waktu")
}

// ─── MERGED FROM SIMPEG: Profile ────────────────────────────────
model Profile {
  id                     String                @id @default(uuid()) @db.Uuid
  role                   String                @default("pendaftar")
  secondary_roles        String[]              @default([])
  full_name              String
  jenis_kelamin          String?
  email                  String?
  phone                  String
  google_meet_link       String?
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  password_hash          String?
  kesehatan_verified     DataKesehatan[]       @relation("KesehatanVerifiedBy")
  dokumen_verified       Dokumen[]             @relation("DokumenVerifiedBy")
  sessions_created       ExamSession[]         @relation("SessionCreatedBy")
  hasil_seleksi_admin    HasilSeleksi[]        @relation("HasilSeleksiBy")
  jadwal_penguji_ortu    JadwalUjian[]         @relation("PengujiOrtu")
  jadwal_penguji_quran   JadwalUjian[]         @relation("PengujiQuran")
  jadwal_penguji_santri  JadwalUjian[]         @relation("PengujiSantri")
  jadwal_penguji_hafalan JadwalUjian[]         @relation("PengujiHafalan")
  jadwal_penguji_arab    JadwalUjian[]         @relation("PengujiArab")
  ketersediaan           KetersediaanPenguji[] @relation("KetersediaanPenguji")
  nilai_input_ortu       NilaiUjian[]          @relation("NilaiInputByOrtu")
  nilai_input_quran      NilaiUjian[]          @relation("NilaiInputByQuran")
  nilai_input_santri     NilaiUjian[]          @relation("NilaiInputBySantri")
  nilai_input_hafalan    NilaiUjian[]          @relation("NilaiInputByHafalan")
  nilai_input_arab       NilaiUjian[]          @relation("NilaiInputByArab")
  pembayaran_verified    Pembayaran[]          @relation("PembayaranVerifiedBy")
  pendaftar              Pendaftar[]
  beasiswa_approved      PengajuanBeasiswa[]   @relation("BeasiswaApprovedBy")
  pengumuman_published   Pengumuman[]          @relation("PengumumanPublishedBy")
  reservasi_approved     ReservasiPSB[]        @relation("ReservasiApprovedBy")
  TransaksiDompet        TransaksiDompet[]
  PerizinanSantri        PerizinanSantri[]
  surat_keluar           SuratKeluar[]     @relation("SuratDibuatOleh")

  @@map("profiles")
}

// ─── MERGED FROM SIMPEG: TahunAjaran ────────────────────────────────
model TahunAjaran {
  id                        String              @id @default(uuid()) @db.Uuid
  tahun_mulai               Int
  tahun_selesai             Int
  nama                      String
  is_active                 Boolean             @default(false)
  tanggal_buka_pendaftaran  DateTime            @db.Date
  tanggal_tutup_pendaftaran DateTime            @db.Date
  biaya_pendaftaran         Decimal             @default(200000.00) @db.Decimal
  link_tes_tertulis         String?
  deskripsi_tes_tertulis    String?
  created_at                DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                DateTime            @default(now()) @db.Timestamptz(6)
  hasil_seleksi             HasilSeleksi[]
  jadwal_ujian              JadwalUjian[]
  pembayaran                Pembayaran[]
  pendaftar                 Pendaftar[]
  pengajuan_beasiswa        PengajuanBeasiswa[]
  pengumuman                Pengumuman[]
  reservasi                 ReservasiPSB[]
  kalender                  KalenderAkademik[]

  @@map("tahun_ajaran")
}

// ─── MERGED FROM SIMPEG: Pendaftar ────────────────────────────────
model Pendaftar {
  id                             String                 @id @default(uuid()) @db.Uuid
  user_id                        String?                @db.Uuid
  tahun_ajaran_id                String                 @db.Uuid
  nomor_pendaftaran              String                 @unique
  nik                            String
  nama_lengkap                   String
  jenis_kelamin                  String
  jenjang                        String
  tempat_lahir                   String?
  tanggal_lahir                  DateTime?              @db.Date
  alamat                         String?
  rt                             String?
  rw                             String?
  kelurahan                      String?
  kecamatan                      String?
  kabupaten                      String?
  provinsi                       String?
  kode_pos                       String?
  no_hp                          String?
  email                          String?
  asal_sekolah                   String?
  npsn                           String?
  alamat_sekolah                 String?
  tahun_lulus                    Int?
  nisn                           String?
  golongan_darah                 String?
  anak_ke                        Int?
  jumlah_saudara                 Int?
  hobi                           String?
  cita_cita                      String?
  sumber_informasi               String?
  jumlah_hafalan                 String?
  tipe_pendaftaran               String                 @default("BARU")
  kelas_masuk                    Int?
  asal_institusi                 String?
  nomor_induk_lama               String?
  catatan_pindahan               String?
  status_pendaftaran             String                 @default("draft")
